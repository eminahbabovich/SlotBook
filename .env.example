# Kopiraj u .env i promijeni vrijednosti. .env ne ide na GitHub.
POSTGRES_DB=slotbook
POSTGRES_USER=slotbook
POSTGRES_PASSWORD=promijeni-me
POSTGRES_PORT=5432

# Ključ za potpis JWT tokena, najmanje 32 bajta. Napravi ga komandom iz README-a.
JWT_SECRET=promijeni-me-nasumicnim-kljucem-od-najmanje-32-bajta

# Slike resursa: local (folder na disku) ili s3 (Cloudflare R2)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=uploads
# Samo za STORAGE_TYPE=s3
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=slotbook-slike
S3_ACCESS_KEY=promijeni-me
S3_SECRET_KEY=promijeni-me

MAIL_HOST=promjeni-me
MAIL_PORT=promjeni-me
MAIL_FROM=promjeni-me
APP_URL=promjeni-me
